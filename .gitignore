# Python cache
__pycache__/
*.pyc
try.py
demo.py

# Generated at build time by tools/generate_tensorplay_version.py
tensorplay/version.py

# Internal development notes (not part of the public docs site)
devdoc/
AGENTS.md

# Type stubs generated by the PyiStub codegen target from the .pyi.in templates
tensorplay/functional.pyi
tensorplay/_C/__init__.pyi
tensorplay/_C/_VariableFunctions.pyi

# Website
website/
node_modules/
**/node_modules/

