{#-
  The factors applied once, to the finished accumulator.

  Fewer operations than scaling each tile as it arrives, and the only thing
  that can go wrong is a factor that would have had to be held at the
  accumulator's width -- which is why the block-shaped recipes are not offered
  here: a factor per 128-by-128 block is not a value the accumulator can carry
  until the contraction is over, and expanding it at the end would mean reading
  the whole factor tensor for one tile.

  So the epilogue knows only the two shapes that fit: one number per operand,
  and one per row on each side.  One per row on each side multiplies into the
  accumulator from opposite axes, which makes it a rank-one product rather than
  two separate multiplies.

  The walk is persistent, and it fuses the two loops the other form keeps apart:
  a program takes one k-step of one tile at a time, and when it has taken the
  last k-step of a tile it scales the accumulator, writes the tile out, and
  starts the accumulator again.  The number of programs is the machine's, not
  the problem's.

  A tile is read either by address or through a descriptor, and which one is not
  a tuning knob.  A descriptor states the mapping once and is then asked for
  tiles by coordinate, so the address arithmetic is not repeated per tile; what
  it costs is a 32-bit coordinate and a hardware feature, so the caller decides
  it after asking whether the extents and the furthest address fit in 32 bits at
  all.  A toolkit that has only the earlier name for building one needs a
  workspace to build it in, and says so once per program before the first tile
  is asked for.
-#}
import triton
import triton.language as tl

{#- The index type travels with the launch rather than with the body: it is a
    property of the call, and a body that narrows an index has to name the type
    it narrows to. #}
INDEX_DTYPE = {{ index_dtype }}


@triton.jit
def load_scales(scale_ptr, RECIPE: tl.constexpr):
    """The factor itself for a whole tensor, and where the rest of them are.

    A tensor's factor is a single number, so it is read where the program
    starts and the walk carries the number.  Every other shape is a region of
    factors, so what the caller hands over is a place and the part this tile
    needs is read when the tile is finished.
    """

    if RECIPE == 0:
        return tl.load(scale_ptr)
    else:
        return scale_ptr


@triton.jit
def apply_scaling(accumulator, a_scale, b_scale, RECIPE_A: tl.constexpr,
                  RECIPE_B: tl.constexpr, offs_cm, offs_cn, M, N,
                  stride_a_scale_m, stride_b_scale_n):
    """The accumulator, multiplied by the factors of the tile just finished."""

    if RECIPE_A == 1 and RECIPE_B == 1:
        # One factor per row on each side multiplies into the accumulator from
        # opposite axes, so it is a rank-one product.
        by_row = tl.load(
            a_scale + offs_cm * stride_a_scale_m, mask=offs_cm < M, other=0.0,
        )
        by_column = tl.load(
            b_scale + offs_cn * stride_b_scale_n, mask=offs_cn < N, other=0.0,
        )
        factor = by_row[:, None] * by_column[None, :]
    else:
        # One number per tensor multiplies in as a scalar.
        factor = a_scale * b_scale
    return accumulator * factor


