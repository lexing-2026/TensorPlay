    M = {{ size("A", 0) }}
    N = {{ size("B", 1) }}
    K = {{ size("A", 1) }}
    if M * N == 0:
        return

    stride_am = {{ stride("A", 0) }}
    stride_ak = {{ stride("A", 1) }}
    stride_bk = {{ stride("B", 0) }}
    stride_bn = {{ stride("B", 1) }}
    stride_cm = {{ stride("C", 0) }}
    stride_cn = {{ stride("C", 1) }}

    if RECIPE_A == 1:
        stride_a_scale_m = 1
    else:
        stride_a_scale_m = 0
    if RECIPE_B == 1:
        stride_b_scale_n = 1
    else:
        stride_b_scale_n = 0

    start_pid = tl.program_id(axis=0).to(INDEX_DTYPE)
    num_pid_m = tl.cdiv(M, BLOCK_M)
    num_pid_n = tl.cdiv(N, BLOCK_N)
    k_tiles = tl.cdiv(K, BLOCK_K)
    num_tiles = num_pid_m * num_pid_n

{%- if USE_TMA_LOAD %}
{%- if USE_EXPERIMENTAL_MAKE_TENSOR_DESCRIPTOR %}
    # The mapping is stated once per program and once per operand, in a
    # workspace this program owns, and no tile is asked for before the device
    # can see the mapping.
    workspace_base = ws_ptr + start_pid.to(tl.int64) * 2 * TMA_SIZE
    a_desc_ptr = workspace_base
    b_desc_ptr = workspace_base + TMA_SIZE
    triton.language.extra.cuda.experimental_device_tensormap_create2d(
        desc_ptr=a_desc_ptr,
        global_address=A_ptr,
        load_size=[BLOCK_M, BLOCK_K],
        global_size=[M, K],
        element_ty=A_ptr.dtype.element_ty,
    )
    triton.language.extra.cuda.experimental_device_tensormap_create2d(
        desc_ptr=b_desc_ptr,
        global_address=B_ptr,
        load_size=[BLOCK_N, BLOCK_K],
        global_size=[N, K],
        element_ty=B_ptr.dtype.element_ty,
    )
    tl.extra.cuda.experimental_tensormap_fenceproxy_acquire(a_desc_ptr)
    tl.extra.cuda.experimental_tensormap_fenceproxy_acquire(b_desc_ptr)
{%- else %}
    a_desc = triton.language.make_tensor_descriptor(
        base=A_ptr,
        shape=[M, K],
        strides=[stride_am, 1],
        block_shape=[BLOCK_M, BLOCK_K],
    )
    b_desc = triton.language.make_tensor_descriptor(
        base=B_ptr,
        shape=[N, K],
        strides=[stride_bn, 1],
        block_shape=[BLOCK_N, BLOCK_K],
    )
{%- endif %}
{%- endif %}

    # The work is shared out rather than handed out: a program takes every
    # NUM_SMS'th tile, and the share that leaves over goes to the first few.
    tiles_per_SM = num_tiles // NUM_SMS
    if start_pid < num_tiles % NUM_SMS:
        tiles_per_SM += 1

    tile_id = start_pid - NUM_SMS
    ki = -1
    # The tile this program is on is named before the walk names it, so that the
    # walk can read it; the name has to be the type the walk gives it.
    pid_m = tl.zeros([], dtype=INDEX_DTYPE)
    pid_n = tl.zeros([], dtype=INDEX_DTYPE)
    offs_am = tl.zeros([], dtype=INDEX_DTYPE)
    offs_bn = tl.zeros([], dtype=INDEX_DTYPE)

    num_pid_in_group = GROUP_M * num_pid_n
    accumulator = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
    a_scale = load_scales(SA_ptr, RECIPE_A)
    b_scale = load_scales(SB_ptr, RECIPE_B)

    for _ in range(0, k_tiles * tiles_per_SM):
        ki = tl.where(ki == k_tiles - 1, 0, ki + 1)
        if ki == 0:
            tile_id += NUM_SMS
            group_id = tile_id // num_pid_in_group
            first_pid_m = group_id * GROUP_M
            group_rows = min(num_pid_m - first_pid_m, GROUP_M)
            pid_m = first_pid_m + (tile_id % group_rows)
            pid_n = (tile_id % num_pid_in_group) // group_rows

            offs_am = pid_m * BLOCK_M
            offs_bn = pid_n * BLOCK_N

        offs_k = ki * BLOCK_K
{%- if USE_TMA_LOAD %}
        offs_am_desc = offs_am.to(tl.int32)
        offs_bn_desc = offs_bn.to(tl.int32)
        offs_k_desc = offs_k.to(tl.int32)
{%- if USE_EXPERIMENTAL_MAKE_TENSOR_DESCRIPTOR %}
        a = tl._experimental_descriptor_load(
            a_desc_ptr, [offs_am_desc, offs_k_desc], [BLOCK_M, BLOCK_K],
            A_ptr.dtype.element_ty,
        )
        b = tl._experimental_descriptor_load(
            b_desc_ptr, [offs_bn_desc, offs_k_desc], [BLOCK_N, BLOCK_K],
            B_ptr.dtype.element_ty,
        )
{%- else %}
        a = tl.load_tensor_descriptor(a_desc, [offs_am_desc, offs_k_desc])
        b = tl.load_tensor_descriptor(b_desc, [offs_bn_desc, offs_k_desc])
{%- endif %}
{%- else %}
        rm = offs_am + tl.arange(0, BLOCK_M)
        rn = offs_bn + tl.arange(0, BLOCK_N)
        inner = offs_k + tl.arange(0, BLOCK_K)
        a = tl.load(
            A_ptr + rm[:, None] * stride_am + inner[None, :],
            mask=(rm[:, None] < M) & (inner[None, :] < K),
            other=tl.zeros((), dtype=A_ptr.dtype.element_ty),
        )
        b = tl.load(
            B_ptr + inner[:, None] * stride_bk + rn[None, :],
            mask=(inner[:, None] < K) & (rn[None, :] < N),
            other=tl.zeros((), dtype=B_ptr.dtype.element_ty),
        )
{%- endif %}
{%- if USE_TMA_LOAD %}
        # A descriptor hands the right tile over already transposed, so the
        # multiply is the mirror of the one the address form needs.
        accumulator = tl.dot(a, b.T, accumulator, allow_tf32=ALLOW_TF32)
{%- else %}
        accumulator = tl.dot(a, b, accumulator, allow_tf32=ALLOW_TF32)
{%- endif %}

        if ki == k_tiles - 1:
            offs_cm = offs_am + tl.arange(0, BLOCK_M)
            offs_cn = offs_bn + tl.arange(0, BLOCK_N)
            accumulator = apply_scaling(
                accumulator, a_scale, b_scale, RECIPE_A, RECIPE_B,
                offs_cm, offs_cn, M, N, stride_a_scale_m, stride_b_scale_n,
            )
            tl.store(
                C_ptr + offs_cm[:, None] * stride_cm + offs_cn[None, :] * stride_cn,
                accumulator,
                mask=(offs_cm[:, None] < M) & (offs_cn[None, :] < N),
            )
            accumulator = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
