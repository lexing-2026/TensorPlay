{#-
  The factors applied to every tile as it arrives.

  The accumulator only ever holds unscaled products, and a factor is paid for
  once per tile rather than once per element of the result -- which is what
  makes the block-shaped recipes available here at all: a factor per
  128-by-128 block is expanded onto the tile's shape before it multiplies
  anything, and a factor per block one row wide is expanded the same way.  The
  expansion is a broadcast followed by a reshape: the load is small and the
  multiply is not, and doing the expansion once per tile rather than once per
  element of it is the point of doing it here at all.

  The tiles are walked by a fixed number of programs rather than one program per
  tile, so whatever runs together reads the same rows of the left operand: the
  walk is what decides which programs run at the same time, and a factor block
  is shared by everything running together.

  A tile is read either by address or through a descriptor, and which one is not
  a tuning knob.  A descriptor states the mapping once and is then asked for
  tiles by coordinate, so the address arithmetic is not repeated per tile; what
  it costs is a 32-bit coordinate and a hardware feature, so the caller decides
  it after asking whether the extents and the furthest address fit in 32 bits at
  all.  A toolkit that has only the earlier name for building one needs a
  workspace to build it in, and says so once per program before the first tile
  is asked for.
-#}
import triton
import triton.language as tl

{#- The index type travels with the launch rather than with the body: it is a
    property of the call, and a body that narrows an index has to name the type
    it narrows to. #}
INDEX_DTYPE = {{ index_dtype }}


@triton.jit
def _scale_rows(scale, rows, extent, stride):
    """One factor per row, gathered for the rows this tile covers."""

    return tl.load(scale + rows * stride, mask=rows < extent, other=0.0)


@triton.jit
def _scale_block_128(scale, block, step, row_blocks, inner_blocks,
                     BLOCK_ROWS, BLOCK_INNER):
    """One factor per 128-by-128 block, laid over the tile that covers it.

    A tile narrower than the block has no whole number of blocks in it, so the
    block is counted in units of the tile rather than in units of the block, and
    the block's own width is what each gathered value is repeated across.
    """

    rows = block * tl.cdiv(BLOCK_ROWS, 128) + tl.arange(0, (BLOCK_ROWS + 127) // 128)
    inner = step * tl.cdiv(BLOCK_INNER, 128) + tl.arange(0, (BLOCK_INNER + 127) // 128)
    factors = tl.load(
        scale + rows[:, None] * inner_blocks + inner[None, :],
        mask=(rows[:, None] < row_blocks) & (inner[None, :] < inner_blocks),
        other=1.0,
    )
    return tl.broadcast_to(
        factors[:, :, None, None],
        ((BLOCK_ROWS + 127) // 128, (BLOCK_INNER + 127) // 128, 128, 128),
    ).reshape(BLOCK_ROWS, BLOCK_INNER)


@triton.jit
def _scale_block_1xtile(scale, block, step, extent, inner_blocks,
                        BLOCK_ROWS, BLOCK_INNER, TILE_INNER):
    """One factor per block one row wide, laid over the tile that covers it."""

    rows = block * BLOCK_ROWS + tl.arange(0, BLOCK_ROWS)
    inner = step * (BLOCK_INNER // TILE_INNER) + tl.arange(0, BLOCK_INNER // TILE_INNER)
    factors = tl.load(
        scale + rows[:, None] * inner_blocks + inner[None, :],
        mask=(rows[:, None] < extent) & (inner[None, :] < inner_blocks),
        other=1.0,
    )
    return tl.broadcast_to(factors[:, :, None], (BLOCK_ROWS, BLOCK_INNER // TILE_INNER, TILE_INNER)) \
        .reshape(BLOCK_ROWS, BLOCK_INNER)


